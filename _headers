# Netlify Headers Configuration
/videos/*
  Content-Type: video/mp4
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Global Assets Cache
/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=2592000
